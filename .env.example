# Copy to .env and edit. The systemd unit reads this file directly
# (EnvironmentFile), and scripts/setup.sh, scripts/run.sh, scripts/memguard.sh
# and scripts/install-service.sh export it before starting. app/config.py itself
# reads only the process environment, so a dashboard started some other way —
# `python -m app.main` by hand — will not see it.
#
# Every line below shows the built-in default. Uncomment only what you change.

# --- web server -------------------------------------------------------------
# 0.0.0.0 means the whole network can reach it. There is no authentication.
#LLMD_HOST=0.0.0.0
#LLMD_PORT=8700

# --- storage ----------------------------------------------------------------
# Database, job logs and uploads. The only directory the dashboard owns outright.
#LLMD_STATE_DIR=~/.local/share/llm-dashboard
# The shared HuggingFace cache. Root-owned: readable here, written by containers.
#LLMD_HF_CACHE=~/models/hf-cache
# Where fine-tunes, Heretic runs and other job artefacts land.
#LLMD_OUTPUT_DIR=~/models/outputs
# Uploaded JSONL training sets.
#LLMD_DATASET_DIR=~/models/datasets

# --- container images -------------------------------------------------------
# Built by scripts/setup.sh from docker/vllm.Dockerfile — there is nothing to
# pull under this name. It is the NGC image plus the xgrammar its vLLM imports.
#LLMD_VLLM_IMAGE=llmd/vllm:latest
# The NGC image all three worker images are built from.
#LLMD_VLLM_BASE_IMAGE=nvcr.io/nvidia/vllm:26.07-py3
#LLMD_HERETIC_IMAGE=llmd/heretic:latest
#LLMD_FINETUNE_IMAGE=llmd/finetune:latest
# Prefix for containers the dashboard starts, so it can tell its own from yours.
#LLMD_CONTAINER_PREFIX=llmd-

# --- HuggingFace ------------------------------------------------------------
# Needed for gated repos; falls back to HF_TOKEN. A token stored from the Models
# tab lives in the database instead; either reaches everything — Hub search,
# downloads, and the server, fine-tuning and Heretic containers — with this one
# winning if both are set.
#LLMD_HF_TOKEN=

# --- host memory safety — read docs/MEMORY.md before touching these ---------
# Host memory that must stay unclaimed after a launch. Raising the ceiling this
# implies is how you get a frozen machine.
#LLMD_MEM_RESERVE_GIB=32
# Softer line: launches above it are allowed but warned about.
#LLMD_MEM_WARN_RESERVE_GIB=38
# The watchdog kills the biggest vLLM container below this much MemAvailable.
#LLMD_MEMGUARD_THRESHOLD_MIB=10240
# Set to 0 to stop the dashboard running the watchdog at all.
#LLMD_MEMGUARD_ENABLED=1

# --- cluster fabric ---------------------------------------------------------
# Both are empty by default, and empty means "work it out". The interface that
# reaches your peers is named differently on every machine, so it is detected
# per node; a single-machine server is handed no interface setting at all.
# Set LLMD_ROCE_IF only to override the detection. Do not set it to a name that
# is absent on the box: NCCL refuses to initialise on an unknown interface even
# at world size 1, so a wrong value is worse than none.
#LLMD_ROCE_IF=
# RDMA is opt-in, for the same reason.
#LLMD_ROCE_HCA=

# --- polling ----------------------------------------------------------------
# Seconds between telemetry samples pushed to connected browsers.
#LLMD_TELEMETRY_INTERVAL=2.0
